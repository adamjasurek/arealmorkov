# Admin + API (pouze server, nastavit ve Vercelu nebo pro `vercel dev`)
ADMIN_PASSWORD=
# Tajný klíč pro per-session tokeny (min. 32 znaků, náhodný řetězec)
ADMIN_SESSION_SECRET=
# Volitelné: legacy statický token (fallback pro ověření)
ADMIN_AUTH_TOKEN=

# GitHub Contents API
GITHUB_TOKEN=
GITHUB_REPO=owner/arealmorkov
GITHUB_BRANCH=main

# Volitelné: ponechat JPG/PNG po konverzi (výchozí = smaže po úspěšné konverzi)
# KEEP_IMAGE_SOURCES=1

# EmailJS – https://www.emailjs.com/
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
